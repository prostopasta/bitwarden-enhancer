@@ -170,4 +170,14 @@ export class VaultItemsComponent implements OnInit, OnChanges, OnDestroy {
+  sortByUrl = (a: TableItem, b: TableItem, direction: SortDirection) => {
+    const r = this.prioritizeCollections(a, b);
+    if (0 !== r) return r;
+    const getUri = (item: TableItem): string => {
+      return item.cipher ? (CipherView.getLaunchUri(item.cipher) || "") : (item.collection?.name || "");
+    };
+    return getUri(a).localeCompare(getUri(b));
+  };
